{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
  ],
  onboarding: false,
  requireConfig: "optional",
  prHourlyLimit: 0,
  customManagers: [
    {
      customType: "regex",
      description: "Process version annotations in Docker Bake files",
      managerFilePatterns: ["/(^|/)docker-bake\\.hcl$/"],
      matchStrings: [
        'datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\n\\s*default = "(?<currentValue>[^"]+)"',
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
    {
      customType: "regex",
      description: "Track Git branch HEAD digests in Docker Bake files",
      managerFilePatterns: ["/(^|/)docker-bake\\.hcl$/"],
      matchStrings: [
        'datasource=git-refs packageName=(?<packageName>\\S+) depName=(?<depName>\\S+) currentValue=(?<currentValue>\\S+)\\n\\s*default = "(?<currentDigest>[a-f0-9]{7,40})"',
      ],
      currentValueTemplate: "{{{currentValue}}}",
      datasourceTemplate: "git-refs",
    },
  ],
  packageRules: [
    {
      description: ["Container app update commits"],
      addLabels: ["app/{{parentDir}}"],
      additionalBranchPrefix: "{{parentDir}}-",
      commitMessageTopic: "{{depName}}",
      semanticCommitScope: "{{parentDir}}",
      semanticCommitType: "release",
      matchFileNames: ["apps/**/docker-bake.hcl", "apps/**/Dockerfile"],
    },
    {
      description: ["Auto-merge app source bumps after checks pass"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
      matchFileNames: ["apps/**/docker-bake.hcl"],
    },
  ],
}
